# ========================================================
# Amora Artesanal - Arquivo de Configuração de Exemplo (.env.example)
# Copie este arquivo para .env no ambiente de desenvolvimento/produção
# ========================================================

# Aplicação
APP_NAME="Amora Artesanal"
APP_ENV=development
APP_URL=http://localhost:8000
APP_PUBLIC_URL=https://lar-bc.github.io/amora_artesanal
APP_DEBUG=true

# Banco de Dados Relacional
# Opção 1: SQLite (Padrão autossuficiente - não requer servidor MySQL instalado)
DB_CONNECTION=sqlite
DB_DATABASE=database/amora_artesanal.sqlite

# Opção 2: MySQL / MariaDB (Para servidores XAMPP / produção em larga escala)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=amora_artesanal
# DB_USERNAME=root
# DB_PASSWORD=

# Serviços e APIs Externas
VIACEP_API_URL=https://viacep.com.br/ws
OPENSTREETMAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Políticas de Logística e Rastreamento
LOGISTICA_TRANSPORTADORA="LogiAmora Transportes / Sedex"
LOGISTICA_DRONE_ATIVO=true
LOGISTICA_RODOVIA_BR364_ATIVO=true

# Políticas de Segurança e Auditoria
SISTEMA_AUDITORIA_REEMBOLSO_DUPLO=true
SISTEMA_VALIDACAO_DOMINIO_EMAIL=true
